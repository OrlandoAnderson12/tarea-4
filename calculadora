#include <stdio.h>
#include <math.h>
#include <stdlib.h>
int main()
{
    double num1, num2;
    char operador;

    printf("Calculadora simple\n");
    printf("--------------------\n\n");

    printf("Primer numero: ");
    scanf("%lf", &num1);

    printf("Segundo numero: ");
    scanf("%lf", &num2);

    printf("Operador (+, -, *, /, ^, sqrt): ");
    scanf(" %c", &operador);

    // Validación del operador
    while (operador != '+' && operador != '-' &&
           operador != '*' && operador != '/' && operador != '^' && operador != 's')

    {
        printf("Operador invalido. Use +, -, *, / o sqrt : ");
        scanf(" %c", &operador);
    }

    switch (operador)
    {
        case '+':
            printf("Resultado: %.2lf\n", num1 + num2);
            break;

        case '-':
            printf("Resultado: %.2lf\n", num1 - num2);
            break;

        case '*':
            printf("Resultado: %.2lf\n", num1 * num2);
            break;

        case '/':
            if (num2 != 0) {
                printf("Resultado: %.2lf\n", num1 / num2);
            } else {
                printf("Error: Division por cero no permitida\n");
            }
            break;

        case '^':
            printf("Resultado: %.2lf ^ %.2lf = %.4lf\n",
                   num1, num2, pow(num1, num2));
            break;

            case 's':printf("Resultado: sqrt(%.2lf) = %.4lf\n", num1, sqrt(num1));
            break;

        default:
            printf("Error inesperado (esto no deberia aparecer)\n");
            break;
    }

      // ... todo tu código anterior ...

    printf("\n\nPresiona Enter para salir...");
    getchar();          // consume el salto de línea que quedó
    getchar();          // espera que presiones Enter

    return 0;
}
